# TripWise Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local MongoDB Community Server)
MONGODB_URI=mongodb://localhost:27017/tripwise

# JWT Secret (generate a strong random string in production)
JWT_SECRET=changeme
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Email Configuration (optional - for booking confirmations)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=changeme
EMAIL_PASS=changeme

# Payment Gateway (optional - for Stripe/Razorpay integration)
STRIPE_SECRET_KEY=changeme
RAZORPAY_KEY_ID=changeme
RAZORPAY_KEY_SECRET=changeme